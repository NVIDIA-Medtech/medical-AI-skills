{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "radiology_note_summarizer output",
  "type": "object",
  "required": ["output", "runtime"],
  "properties": {
    "output": {
      "type": "object",
      "required": ["study_instance_uid", "findings", "impressions", "flags_for_followup"],
      "additionalProperties": false,
      "properties": {
        "study_instance_uid": {"type": "string", "minLength": 1},
        "findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "impressions": {"type": "string", "minLength": 1},
        "flags_for_followup": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "model", "endpoint", "temperature",
        "llm_tokens_input", "llm_tokens_output"
      ],
      "additionalProperties": true,
      "properties": {
        "model": {"type": "string"},
        "requested_model": {"type": "string"},
        "system_fingerprint": {"type": ["string", "null"]},
        "endpoint": {"type": "string"},
        "temperature": {"type": "number"},
        "max_tokens": {"type": "integer"},
        "seed": {"type": "integer"},
        "request_id": {"type": "string"},
        "prompt_template_sha256": {"type": "string"},
        "system_prompt_sha256": {"type": "string"},
        "llm_tokens_input": {"type": "integer", "minimum": 0},
        "llm_tokens_output": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "mock": {"type": "boolean"}
      }
    }
  }
}
