{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Shared envelope (invocation, output, runtime) converged with nv_segment_ct. Canonical intersection spec: spec/segmentation_output.schema.json. The eval_engine loads this file without an out-of-tree $ref resolver, so the shared required block is reproduced inline here rather than via $ref.",
  "title": "holohub_imaging_ai_segmentator output",
  "type": "object",
  "required": ["invocation", "output", "runtime", "logs"],
  "additionalProperties": false,
  "properties": {
    "logs": {
      "type": "object",
      "required": ["stdout_tail", "stderr_tail"],
      "additionalProperties": false,
      "properties": {
        "stdout_tail": {"type": "string"},
        "stderr_tail": {"type": "string"}
      }
    },
    "invocation": {
      "type": "object",
      "required": ["holohub_root", "holohub_commit", "mode", "command", "exit_code"],
      "additionalProperties": true,
      "properties": {
        "holohub_root": {"type": "string"},
        "holohub_commit": {"type": "string"},
        "mode": {"type": "string", "enum": ["container", "local"]},
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "container_image": {"type": ["string", "null"]},
        "container_image_id": {"type": ["string", "null"]},
        "input_path": {"type": "string"},
        "output_path": {"type": "string"},
        "model_path": {"type": ["string", "null"]}
      }
    },
    "output": {
      "type": "object",
      "required": ["dicom_seg", "nifti", "seg_signals"],
      "additionalProperties": false,
      "properties": {
        "seg_signals": {
          "type": "object",
          "required": ["seg_pixel_max_value", "empty_segmentation_warning"],
          "additionalProperties": false,
          "properties": {
            "seg_pixel_max_value": {"type": ["integer", "null"]},
            "seg_array_shape": {
              "type": ["array", "null"],
              "items": {"type": "integer"}
            },
            "empty_segmentation_warning": {"type": "boolean"}
          }
        },
        "dicom_seg": {
          "type": "object",
          "required": ["count", "total_bytes", "files"],
          "additionalProperties": false,
          "properties": {
            "count": {"type": "integer"},
            "total_bytes": {"type": "integer"},
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "bytes", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "path": {"type": "string"},
                  "bytes": {"type": "integer"},
                  "sha256": {"type": "string"}
                }
              }
            }
          }
        },
        "nifti": {
          "type": "object",
          "required": ["original", "segmentation"],
          "additionalProperties": false,
          "properties": {
            "original": {"$ref": "#/$defs/file_group"},
            "segmentation": {"$ref": "#/$defs/file_group"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["subprocess_seconds"],
      "additionalProperties": true,
      "properties": {
        "subprocess_seconds": {"type": "number"},
        "app_seconds": {"type": ["number", "null"]}
      }
    }
  },
  "$defs": {
    "file_group": {
      "type": "object",
      "required": ["count", "total_bytes", "files"],
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer"},
        "total_bytes": {"type": "integer"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "bytes": {"type": "integer"},
              "sha256": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
