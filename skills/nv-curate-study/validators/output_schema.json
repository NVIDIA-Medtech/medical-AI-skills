{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NvCurateStudyOutput",
  "type": "object",
  "required": ["skill", "study_uid", "mode", "join", "publish"],
  "additionalProperties": true,
  "properties": {
    "skill": {"type": "string", "const": "nv-curate-study"},
    "study_uid": {"type": "string"},
    "mode": {"type": "string", "enum": ["mock", "live"]},
    "mri": {"type": "object"},
    "reports": {"type": "object"},
    "join": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["matched", "rejected"]},
        "reason": {"type": "string"},
        "join_key": {"type": "string"}
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "skip_upload": {"type": "boolean"},
        "blocked": {"type": "boolean"},
        "repo_id": {"type": ["string", "null"]}
      }
    },
    "runtime": {"type": "object"}
  }
}
