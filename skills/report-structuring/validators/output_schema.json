{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportStructuringOutput",
  "type": "object",
  "required": ["skill", "model", "n_reports", "parse", "sections", "qc", "format"],
  "additionalProperties": true,
  "properties": {
    "skill": {"type": "string"},
    "model": {"type": "string"},
    "n_reports": {"type": "integer", "minimum": 0},
    "parse": {
      "type": "object",
      "required": ["method", "n_evaluated", "n_parse_failures", "parse_success_rate"],
      "properties": {
        "method": {"type": "string"},
        "n_evaluated": {"type": "integer", "minimum": 0},
        "n_parse_failures": {"type": "integer", "minimum": 0},
        "parse_success_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "sections": {
      "type": "object",
      "required": ["n_with_findings", "n_with_impression", "completeness_rate"],
      "properties": {
        "n_with_findings": {"type": "integer", "minimum": 0},
        "n_with_impression": {"type": "integer", "minimum": 0},
        "completeness_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "qc": {
      "type": "object",
      "required": ["method", "n_evaluated", "n_pass", "n_fail", "n_unknown", "pass_rate"],
      "properties": {
        "method": {"type": "string"},
        "n_evaluated": {"type": "integer", "minimum": 0},
        "n_pass": {"type": "integer", "minimum": 0},
        "n_fail": {"type": "integer", "minimum": 0},
        "n_unknown": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "format": {
      "type": "object",
      "required": ["n_findings_bulleted", "n_header_leaks", "n_format_violations"],
      "properties": {
        "n_findings_bulleted": {"type": "integer", "minimum": 0},
        "n_header_leaks": {"type": "integer", "minimum": 0},
        "n_format_violations": {"type": "integer", "minimum": 0}
      }
    },
    "runtime": {"type": "object"},
    "artifacts": {"type": "object"}
  }
}
