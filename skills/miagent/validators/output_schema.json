{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skill", "operation", "status", "workspace_path", "artifacts", "phase", "research_completed", "experiments_launched"],
  "additionalProperties": false,
  "properties": {
    "skill": {"const": "miagent"},
    "operation": {"const": "initialize"},
    "status": {"const": "initialized"},
    "workspace_path": {"type": "string", "minLength": 1},
    "artifacts": {"const": ["challenge.md", "dashboard.md", "trajectory.md"]},
    "phase": {"const": "understand"},
    "research_completed": {"const": false},
    "experiments_launched": {"const": 0}
  }
}
