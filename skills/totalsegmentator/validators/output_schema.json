{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Output shape for the totalsegmentator skill. Mirrors the shared segmentation envelope established by nv_segment_ct and holohub_imaging_ai_segmentator (see spec/segmentation_output.schema.json) and adds a `task` / `task_license` / `package_version` triplet so consumers can tell which TotalSegmentator task was run and under which weight licence.",
  "title": "TotalSegmentatorOutput",
  "type": "object",
  "required": [
    "skill",
    "model",
    "model_repo",
    "task",
    "task_license",
    "input",
    "output",
    "invocation",
    "runtime",
    "intended_use_disclaimer"
  ],
  "properties": {
    "skill": {"const": "totalsegmentator"},
    "model": {"type": "string"},
    "model_repo": {"type": "string"},
    "package_version": {"type": ["string", "null"]},
    "task": {"type": "string"},
    "task_license": {"type": "string", "enum": ["non_commercial", "academic_only"]},
    "license": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string"},
        "shape": {"type": "array", "items": {"type": "integer"}},
        "ndim": {"type": "integer"},
        "spacing": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "ground_truth_path": {"type": ["string", "null"]}
      }
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "shape",
        "label_prompts_requested",
        "label_ids_present",
        "unexpected_label_ids",
        "label_set_valid",
        "class_counts",
        "voxel_volume_ml",
        "class_volumes_ml",
        "any_label_present",
        "geometry"
      ],
      "properties": {
        "path": {"type": ["string", "null"]},
        "shape": {"type": "array", "items": {"type": "integer"}},
        "label_prompts_requested": {"type": "array", "items": {"type": "integer"}},
        "label_ids_present": {"type": "array", "items": {"type": "integer"}},
        "unexpected_label_ids": {"type": "array", "items": {"type": "integer"}},
        "label_set_valid": {"type": "boolean"},
        "class_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "voxel_volume_ml": {"type": ["number", "null"]},
        "class_volumes_ml": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "any_label_present": {"type": "boolean"},
        "geometry": {
          "type": "object",
          "required": [
            "input_shape",
            "output_shape",
            "shape_match",
            "input_spacing",
            "output_spacing",
            "spacing_match",
            "affine_max_abs_diff",
            "affine_match"
          ],
          "properties": {
            "input_shape": {"type": "array", "items": {"type": "integer"}},
            "output_shape": {"type": "array", "items": {"type": "integer"}},
            "shape_match": {"type": "boolean"},
            "input_spacing": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
            "output_spacing": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
            "spacing_match": {"type": "boolean"},
            "affine_max_abs_diff": {"type": ["number", "null"]},
            "affine_match": {"type": "boolean"}
          }
        }
      }
    },
    "invocation": {
      "type": "object",
      "required": ["python_api", "ml"],
      "properties": {
        "python_api": {"type": "string"},
        "ml": {"type": "boolean"},
        "fast": {"type": "boolean"},
        "roi_subset_class_ids": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["inference_seconds", "device"],
      "properties": {
        "inference_seconds": {"type": "number"},
        "device": {"type": "string"},
        "ts_device_arg": {"type": "string"}
      }
    },
    "intended_use_disclaimer": {"type": "string"}
  }
}
