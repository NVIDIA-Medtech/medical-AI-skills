{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "holohub_flow_benchmark output",
  "type": "object",
  "required": [
    "skill",
    "input",
    "environment",
    "plan",
    "invocation",
    "output",
    "analysis",
    "domain",
    "contract",
    "runtime",
    "logs",
    "intended_use_disclaimer"
  ],
  "additionalProperties": false,
  "properties": {
    "skill": {"const": "holohub_flow_benchmark"},
    "input": {
      "type": "object",
      "required": ["fixture"],
      "additionalProperties": true,
      "properties": {
        "fixture": {"type": "string"}
      }
    },
    "environment": {"type": "object", "additionalProperties": true},
    "plan": {
      "type": "object",
      "required": ["app", "language", "schedulers", "run_mode"],
      "additionalProperties": true,
      "properties": {
        "app": {"type": "string", "minLength": 1},
        "language": {"type": "string", "enum": ["cpp", "python"]},
        "schedulers": {
          "type": "array",
          "items": {"type": "string", "enum": ["greedy", "multithread", "eventbased"]},
          "minItems": 1
        },
        "run_mode": {"type": "string", "enum": ["container", "local"]}
      }
    },
    "invocation": {
      "type": "object",
      "required": [
        "holohub_root",
        "holohub_commit",
        "benchmark_script",
        "benchmark_command",
        "benchmark_exit_code"
      ],
      "additionalProperties": true,
      "properties": {
        "holohub_root": {"type": "string"},
        "holohub_commit": {"type": "string"},
        "benchmark_script": {"type": "string"},
        "benchmark_command": {"type": "array", "items": {"type": "string"}},
        "benchmark_exit_code": {"type": ["integer", "null"]}
      }
    },
    "output": {
      "type": "object",
      "required": ["logger", "gpu_utilization", "other"],
      "additionalProperties": true,
      "properties": {
        "logger": {"$ref": "#/$defs/file_group"},
        "gpu_utilization": {"$ref": "#/$defs/file_group"},
        "other": {"$ref": "#/$defs/file_group"}
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "schedulers",
        "paths_observed",
        "total_latency_samples",
        "first_path",
        "gpu_utilization"
      ],
      "additionalProperties": true,
      "properties": {
        "schedulers": {"type": "object"},
        "paths_observed": {"type": "integer", "minimum": 0},
        "total_latency_samples": {"type": "integer", "minimum": 0},
        "first_path": {"type": "object"},
        "gpu_utilization": {"type": "object"}
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "app",
        "logger_count_matches_plan",
        "scheduler_coverage_complete",
        "benchmark_log"
      ],
      "additionalProperties": true,
      "properties": {
        "app": {"type": "string"},
        "logger_count_matches_plan": {"type": "boolean"},
        "scheduler_coverage_complete": {"type": "boolean"},
        "benchmark_log": {"type": "object"}
      }
    },
    "contract": {
      "type": "object",
      "required": ["present", "path", "assertions"],
      "additionalProperties": true,
      "properties": {
        "present": {"type": "boolean"},
        "path": {"type": "string"},
        "assertions": {
          "type": "object",
          "required": ["all_required_assertions_passed"],
          "additionalProperties": {"type": "boolean"},
          "properties": {
            "all_required_assertions_passed": {"type": "boolean"}
          }
        }
      }
    },
    "runtime": {"type": "object", "additionalProperties": true},
    "logs": {"type": "object", "additionalProperties": true},
    "intended_use_disclaimer": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "file_group": {
      "type": "object",
      "required": ["count", "total_bytes", "files"],
      "additionalProperties": true,
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "files": {"type": "array"}
      }
    }
  }
}
