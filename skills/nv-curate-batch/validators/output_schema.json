{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NvCurateBatchOutput",
  "type": "object",
  "required": ["skill", "batch_id", "mode", "n_studies", "n_matched", "n_rejected", "publish"],
  "additionalProperties": true,
  "properties": {
    "skill": {"type": "string", "const": "nv-curate-batch"},
    "batch_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["mock", "live"]},
    "n_studies": {"type": "integer", "minimum": 0},
    "n_matched": {"type": "integer", "minimum": 0},
    "n_rejected": {"type": "integer", "minimum": 0},
    "matched": {"type": "array"},
    "rejected": {"type": "array"},
    "smoke": {"type": "object"},
    "publish": {"type": "object"},
    "runtime": {"type": "object"}
  }
}
