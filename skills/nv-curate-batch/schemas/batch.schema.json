{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NvCurateBatchConfig",
  "type": "object",
  "required": ["batch_id", "studies"],
  "additionalProperties": true,
  "properties": {
    "batch_id": {"type": "string"},
    "site": {"type": "string"},
    "smoke_limit": {"type": "integer", "minimum": 0},
    "fail_closed": {"type": "boolean", "default": true},
    "llm": {
      "type": "object",
      "description": "Local OpenAI-compatible report LLM applied to every study (default: Nemotron 3 Super 120B)",
      "properties": {
        "backend": {"type": "string", "default": "openai"},
        "model": {
          "type": "string",
          "default": "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4"
        },
        "base_url": {
          "type": "string",
          "default": "http://127.0.0.1:8080"
        },
        "api_key": {"type": "string", "default": "EMPTY"}
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "skip_upload": {"type": "boolean", "default": true},
        "repo_id": {"type": ["string", "null"]}
      }
    },
    "studies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "description": "Path to a study.json"},
          {"type": "object", "description": "Inline study config (nv-curate-study schema)"}
        ]
      }
    }
  }
}
