{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "totalsegmentator_skeleton_topology_v1 output",
  "type": "object",
  "required": [
    "verifier",
    "target",
    "input_inventory",
    "vertebra_chain",
    "vertebra_body_size_monotonic",
    "rib_pair_symmetry",
    "overall"
  ],
  "additionalProperties": true,
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["evidence_pack", "skill_id", "source_overall_status", "label_map_path"],
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": "string"},
        "label_map_path": {"type": ["string", "null"]}
      }
    },
    "input_inventory": {
      "type": "object",
      "required": ["label_map_path", "label_map_readable", "label_map_shape"],
      "properties": {
        "label_map_path": {"type": ["string", "null"]},
        "label_map_readable": {"type": "boolean"},
        "label_map_shape": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "vertebra_chain": {
      "type": "object",
      "required": ["verdict", "reason", "present_in_order", "violations", "checks"],
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "reason": {"type": "string"},
        "direction": {"type": "string"},
        "present_in_order": {"type": "array"},
        "violations": {"type": "array"},
        "checks": {"type": "array"}
      }
    },
    "vertebra_body_size_monotonic": {
      "type": "object",
      "required": ["verdict", "reason", "violations", "checks"],
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "reason": {"type": "string"},
        "cervical_median_voxels": {"type": ["number", "null"]},
        "thoracic_median_voxels": {"type": ["number", "null"]},
        "lumbar_median_voxels": {"type": ["number", "null"]},
        "cervical_count": {"type": "integer"},
        "thoracic_count": {"type": "integer"},
        "lumbar_count": {"type": "integer"},
        "violations": {"type": "array"},
        "checks": {"type": "array"}
      }
    },
    "rib_pair_symmetry": {
      "type": "object",
      "required": ["verdict", "reason", "pairs", "missing_partners", "asymmetric_pairs", "checks"],
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "reason": {"type": "string"},
        "pairs": {"type": "array"},
        "missing_partners": {"type": "array", "items": {"type": "string"}},
        "asymmetric_pairs": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array"}
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  }
}
