{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "holohub_imaging_segmentation_quality_v1 output",
  "type": "object",
  "required": [
    "verifier",
    "target",
    "artifact_inventory",
    "domain_floor",
    "nifti_metrics",
    "overall"
  ],
  "additionalProperties": false,
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["evidence_pack", "skill_id", "source_overall_status"],
      "additionalProperties": false,
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": "string"},
        "holohub_commit": {"type": ["string", "null"]}
      }
    },
    "artifact_inventory": {"type": "object"},
    "domain_floor": {
      "type": "object",
      "required": ["verdict", "checks"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail"]},
        "checks": {"type": "array"}
      }
    },
    "nifti_metrics": {
      "type": "object",
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]}
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  }
}
