{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report_pathology_quality_v1 output",
  "type": "object",
  "required": ["verifier", "target", "pathology_quality", "checks", "warnings", "overall"],
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target": {"type": "object"},
    "pathology_quality": {
      "type": "object",
      "required": ["n_fail", "n_warn", "verdict", "acceptable"],
      "properties": {
        "n_fail": {"type": "integer"},
        "n_warn": {"type": "integer"},
        "verdict": {"type": "string", "enum": ["pass", "warn", "fail"]},
        "acceptable": {"type": "boolean"},
        "label_coverage_rate": {"type": "number"},
        "json_parse_success_rate": {"type": "number"},
        "n_invalid_labels": {"type": "integer"},
        "n_labels": {"type": "integer"},
        "n_present_total": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "checks": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "overall": {"type": "string", "enum": ["pass", "warn", "fail"]}
  },
  "additionalProperties": false
}
