{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "radiology_note_summary_quality_v1 output",
  "type": "object",
  "required": ["verifier", "target", "summary_quality", "checks", "overall"],
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["evidence_pack", "skill_id", "source_overall_status", "fixture_path"],
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": ["string", "null"]},
        "fixture_path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "summary_quality": {
      "type": "object",
      "required": [
        "verdict",
        "acceptable",
        "mock_mode",
        "forbidden_finding_count",
        "forbidden_findings",
        "study_instance_uid",
        "model"
      ],
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail"]},
        "acceptable": {"type": "boolean"},
        "mock_mode": {"type": "boolean"},
        "forbidden_finding_count": {"type": "integer", "minimum": 0},
        "forbidden_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "pattern", "match"],
            "properties": {
              "label": {"type": "string"},
              "pattern": {"type": "string"},
              "match": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "study_instance_uid": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "reason"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "warn"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  },
  "additionalProperties": false
}
