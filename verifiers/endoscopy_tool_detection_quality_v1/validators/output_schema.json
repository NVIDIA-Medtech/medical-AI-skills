{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "endoscopy_tool_detection_quality_v1 output",
  "type": "object",
  "required": [
    "verifier",
    "target",
    "artifact_inventory",
    "domain_floor",
    "detection_metrics",
    "overall"
  ],
  "additionalProperties": false,
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["evidence_pack", "skill_id", "source_overall_status", "record_type"],
      "additionalProperties": false,
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": "string"},
        "record_type": {"type": "string"}
      }
    },
    "artifact_inventory": {
      "type": "object",
      "required": [
        "recording_output_dir",
        "recording_file_count",
        "usable_recording_file_count",
        "recording_total_bytes",
        "hash_mismatch_count",
        "gxf_index_count",
        "gxf_entities_count",
        "gxf_pair_count",
        "video_count",
        "detection_artifact_count",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "recording_output_dir": {"type": "string"},
        "recording_file_count": {"type": "integer"},
        "usable_recording_file_count": {"type": "integer"},
        "recording_total_bytes": {"type": "integer"},
        "hash_mismatch_count": {"type": "integer"},
        "gxf_index_count": {"type": "integer"},
        "gxf_entities_count": {"type": "integer"},
        "gxf_pair_count": {"type": "integer"},
        "video_count": {"type": "integer"},
        "detection_artifact_count": {"type": "integer"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "declared_path",
              "kind",
              "exists",
              "bytes",
              "declared_bytes",
              "declared_sha256",
              "actual_sha256",
              "hash_checked",
              "hash_match",
              "usable"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "declared_path": {"type": "string"},
              "kind": {"type": "string"},
              "exists": {"type": "boolean"},
              "bytes": {"type": "integer"},
              "declared_bytes": {"type": ["integer", "null"]},
              "declared_sha256": {"type": ["string", "null"]},
              "actual_sha256": {"type": ["string", "null"]},
              "hash_checked": {"type": "boolean"},
              "hash_match": {"type": ["boolean", "null"]},
              "usable": {"type": "boolean"}
            }
          }
        }
      }
    },
    "domain_floor": {"$ref": "#/$defs/verdict_block"},
    "detection_metrics": {
      "type": "object",
      "required": [
        "verdict",
        "reason",
        "source_files",
        "frames_observed",
        "frames_with_detections",
        "tools_detected_count",
        "mean_detections_per_frame",
        "max_detections_per_frame",
        "frame_coverage",
        "bbox_sanity",
        "tool_class_distribution",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "reason": {"type": "string"},
        "source_files": {"type": "array", "items": {"type": "string"}},
        "frames_observed": {"type": "integer"},
        "frames_with_detections": {"type": "integer"},
        "tools_detected_count": {"type": "integer"},
        "mean_detections_per_frame": {"type": "number"},
        "max_detections_per_frame": {"type": "integer"},
        "frame_coverage": {"type": "number"},
        "bbox_sanity": {
          "type": "object",
          "required": ["checked", "invalid"],
          "additionalProperties": false,
          "properties": {
            "checked": {"type": "integer"},
            "invalid": {"type": "integer"}
          }
        },
        "tool_class_distribution": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  },
  "$defs": {
    "verdict_block": {
      "type": "object",
      "required": ["verdict", "checks"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "check": {
      "type": "object",
      "required": ["name", "status", "reason"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "reason": {"type": "string"}
      }
    }
  }
}
