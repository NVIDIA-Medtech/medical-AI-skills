{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "totalsegmentator_hu_consistency_v1 output",
  "type": "object",
  "required": [
    "verifier",
    "target",
    "input_inventory",
    "hu_consistency",
    "overall"
  ],
  "additionalProperties": false,
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": [
        "evidence_pack",
        "skill_id",
        "source_overall_status",
        "input_volume_path",
        "label_map_path"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": "string"},
        "input_volume_path": {"type": ["string", "null"]},
        "label_map_path": {"type": ["string", "null"]}
      }
    },
    "input_inventory": {
      "type": "object",
      "required": [
        "input_volume_path",
        "input_volume_readable",
        "label_map_path",
        "label_map_readable",
        "shape_match",
        "affine_match",
        "input_shape",
        "mask_shape"
      ],
      "additionalProperties": false,
      "properties": {
        "input_volume_path": {"type": ["string", "null"]},
        "input_volume_readable": {"type": "boolean"},
        "label_map_path": {"type": ["string", "null"]},
        "label_map_readable": {"type": "boolean"},
        "shape_match": {"type": "boolean"},
        "affine_match": {"type": "boolean"},
        "input_shape": {"type": "array", "items": {"type": "integer"}},
        "mask_shape": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "hu_consistency": {
      "type": "object",
      "required": [
        "verdict",
        "reason",
        "per_class",
        "classes_out_of_range",
        "checked_count",
        "passing_count",
        "pass_fraction",
        "min_pass_fraction",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "reason": {"type": "string"},
        "per_class": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label_id",
              "name",
              "voxel_count",
              "median_hu",
              "mean_hu",
              "std_hu",
              "p10_hu",
              "p90_hu",
              "in_range",
              "check_status"
            ],
            "additionalProperties": false,
            "properties": {
              "label_id": {"type": "integer"},
              "name": {"type": "string"},
              "voxel_count": {"type": "integer"},
              "median_hu": {"type": "number"},
              "mean_hu": {"type": "number"},
              "std_hu": {"type": "number"},
              "p10_hu": {"type": "number"},
              "p90_hu": {"type": "number"},
              "hu_min_expected": {"type": ["number", "null"]},
              "hu_max_expected": {"type": ["number", "null"]},
              "in_range": {"type": "boolean"},
              "check_status": {"type": "string", "enum": ["checked", "no_bounds"]}
            }
          }
        },
        "classes_out_of_range": {"type": "array", "items": {"type": "string"}},
        "checked_count": {"type": "integer"},
        "passing_count": {"type": "integer"},
        "pass_fraction": {"type": "number"},
        "min_pass_fraction": {"type": "number"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "status", "reason"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "reason": {"type": "string"}
      }
    }
  }
}
