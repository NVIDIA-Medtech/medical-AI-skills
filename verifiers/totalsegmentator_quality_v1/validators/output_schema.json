{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "totalsegmentator_quality_v1 output",
  "type": "object",
  "required": [
    "verifier",
    "target",
    "artifact_inventory",
    "anatomy_plausibility",
    "label_set_subset",
    "gt_metrics",
    "overall"
  ],
  "additionalProperties": false,
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": [
        "evidence_pack",
        "skill_id",
        "source_overall_status",
        "label_map_path",
        "ground_truth_path"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": "string"},
        "label_map_path": {"type": ["string", "null"]},
        "ground_truth_path": {"type": ["string", "null"]}
      }
    },
    "artifact_inventory": {
      "type": "object",
      "required": [
        "label_map_path",
        "label_map_readable",
        "label_map_dtype",
        "label_map_shape",
        "shape_match",
        "affine_match",
        "voxel_volume_ml"
      ],
      "additionalProperties": false,
      "properties": {
        "label_map_path": {"type": ["string", "null"]},
        "label_map_readable": {"type": "boolean"},
        "label_map_dtype": {"type": ["string", "null"]},
        "label_map_shape": {"type": "array", "items": {"type": "integer"}},
        "shape_match": {"type": "boolean"},
        "affine_match": {"type": "boolean"},
        "voxel_volume_ml": {"type": ["number", "null"]}
      }
    },
    "anatomy_plausibility": {
      "type": "object",
      "required": [
        "verdict",
        "per_class",
        "classes_failing_volume_bounds",
        "classes_overfragmented",
        "cross_class",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "per_class": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label_id",
              "name",
              "voxel_count",
              "volume_ml",
              "component_count",
              "largest_cc_fraction"
            ],
            "additionalProperties": false,
            "properties": {
              "label_id": {"type": "integer"},
              "name": {"type": "string"},
              "voxel_count": {"type": "integer"},
              "volume_ml": {"type": "number"},
              "component_count": {"type": "integer"},
              "largest_cc_fraction": {"type": "number"},
              "volume_bounds_ok": {"type": "boolean"},
              "components_ok": {"type": "boolean"},
              "largest_cc_fraction_ok": {"type": "boolean"},
              "bounds": {
                "type": ["object", "null"],
                "additionalProperties": true
              }
            }
          }
        },
        "classes_failing_volume_bounds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "classes_overfragmented": {
          "type": "array",
          "items": {"type": "string"}
        },
        "cross_class": {
          "type": "object",
          "required": ["liver_gt_spleen", "bilateral_symmetry"],
          "additionalProperties": false,
          "properties": {
            "liver_gt_spleen": {
              "type": "object",
              "required": ["status", "reason"],
              "additionalProperties": false,
              "properties": {
                "status": {"type": "string", "enum": ["pass", "fail", "skipped"]},
                "reason": {"type": "string"},
                "liver_volume_ml": {"type": ["number", "null"]},
                "spleen_volume_ml": {"type": ["number", "null"]}
              }
            },
            "bilateral_symmetry": {
              "type": "object",
              "required": ["status", "reason"],
              "additionalProperties": false,
              "properties": {
                "status": {"type": "string", "enum": ["pass", "fail", "skipped"]},
                "reason": {"type": "string"},
                "relative_diff": {"type": ["number", "null"]},
                "pairs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "label_set_subset": {
      "type": "object",
      "required": ["verdict", "reason", "requested", "present", "extras", "missing", "tolerance"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "reason": {"type": "string"},
        "requested": {"type": "array", "items": {"type": "integer"}},
        "present": {"type": "array", "items": {"type": "integer"}},
        "extras": {"type": "array", "items": {"type": "integer"}},
        "missing": {"type": "array", "items": {"type": "integer"}},
        "tolerance": {"type": "integer", "minimum": 0}
      }
    },
    "gt_metrics": {
      "type": "object",
      "required": ["verdict", "acceptable", "reason", "per_class", "checks"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "skipped"]},
        "acceptable": {"type": "boolean"},
        "reason": {"type": "string"},
        "ground_truth_path": {"type": ["string", "null"]},
        "per_class": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label_id", "name", "dice", "iou"],
            "additionalProperties": false,
            "properties": {
              "label_id": {"type": "integer"},
              "name": {"type": "string"},
              "dice": {"type": "number"},
              "iou": {"type": "number"},
              "dice_floor": {"type": ["number", "null"]},
              "dice_ok": {"type": "boolean"}
            }
          }
        },
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "status", "reason"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "reason": {"type": "string"}
      }
    }
  }
}
