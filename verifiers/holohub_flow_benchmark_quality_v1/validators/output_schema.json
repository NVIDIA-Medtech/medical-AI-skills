{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "holohub_flow_benchmark_quality_v1 output",
  "type": "object",
  "required": ["verifier", "target", "flow_quality", "checks", "overall"],
  "properties": {
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["evidence_pack", "skill_id", "source_overall_status"],
      "properties": {
        "evidence_pack": {"type": "string"},
        "skill_id": {"type": "string"},
        "source_overall_status": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "flow_quality": {
      "type": "object",
      "required": [
        "verdict",
        "acceptable",
        "app",
        "run_mode",
        "logger_file_count",
        "gpu_file_count",
        "requested_schedulers",
        "observed_schedulers",
        "scheduler_coverage_complete",
        "paths_observed",
        "total_latency_samples",
        "min_path_sample_count",
        "contract_present",
        "contract_assertions_passed"
      ],
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail"]},
        "acceptable": {"type": "boolean"},
        "app": {"type": ["string", "null"]},
        "run_mode": {"type": ["string", "null"]},
        "logger_file_count": {"type": "integer", "minimum": 0},
        "gpu_file_count": {"type": "integer", "minimum": 0},
        "requested_schedulers": {"type": "array", "items": {"type": "string"}},
        "observed_schedulers": {"type": "array", "items": {"type": "string"}},
        "scheduler_coverage_complete": {"type": "boolean"},
        "paths_observed": {"type": "integer", "minimum": 0},
        "total_latency_samples": {"type": "integer", "minimum": 0},
        "min_path_sample_count": {"type": "integer", "minimum": 0},
        "contract_present": {"type": "boolean"},
        "contract_assertions_passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "reason"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "warn"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "overall": {"type": "string", "enum": ["pass", "fail"]}
  },
  "additionalProperties": false
}
